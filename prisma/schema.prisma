generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Property {
  id String @id @default(uuid())
  ownerId String
  title String
  city String
  locality String
  rent Int
  bedrooms Int
  area Int
  furnishing String
  description String
  images String[]
  latitude Float?
  longitude Float?
  createdAt DateTime @default(now())
  favourites Favourite[]
  enquiries Enquiry[]
  @@index([city, rent])
  @@index([ownerId])
}
model Favourite {
  userId String
  propertyId String
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  @@id([userId, propertyId])
}
model Enquiry {
  id String @id @default(uuid())
  userId String
  propertyId String
  message String
  createdAt DateTime @default(now())
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
