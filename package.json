{
  "name": "smartrent",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run server:build && concurrently \"vite --host 127.0.0.1\" \"node --env-file-if-exists=.env build-server/server/main.js\"",
    "server:build": "tsc -p tsconfig.server.json",
    "build": "prisma generate && tsc --noEmit && npm run server:build && vite build",
    "start": "node --env-file-if-exists=.env build-server/server/main.js",
    "test": "tsx --test server/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/supabase-js": "^2.57.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "js-yaml": "5.4.3",
    "deepmerge-ts": "8.0.2"
  }
}
